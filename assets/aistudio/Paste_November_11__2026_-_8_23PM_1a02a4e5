// =======================================
// TRANSMISIÓN FIREBASE + FALLBACK ESP-NOW
// =======================================
void registrarYTransmitir(int co, float pm25, float temp, int hum, bool alarma, bool esNuevoDisparo, bool tocaHistorial30s) {
  contadorMensajes++;
  unsigned long epochActual = 0;
  actualizarFechaHora(epochActual);

  descripcionCompletaActual = construirDescripcionDetallada(alarma, panicoManual, co, pm25, temp, hum);

  // Si es un nuevo disparo de alarma, anexar al archivo CSV descargable en RAM
  if (esNuevoDisparo) {
    String lineaCSV = fechaActualStr + "," + horaActualStr + "," + origenAlarmaActual + "," +
                      String(co) + "," + String(pm25, 1) + "," + String(temp, 1) + "," + String(hum) + ",\"" +
                      descripcionCompletaActual + "\"\n";
    logAlarmasCSV += lineaCSV;
  }

  bool subidoDirecto = false;

  // 1. SUBIDA DIRECTA A FIREBASE VÍA WI-FI
  if (WiFi.status() == WL_CONNECTED && Firebase.ready()) {
    // A. Actualizar estado actual en la raíz del dispositivo
    FirebaseJson jsonRaiz;
    jsonRaiz.set("CO", co);
    jsonRaiz.set("PM2_5", (int)pm25);
    jsonRaiz.set("temperatura", temp);
    jsonRaiz.set("humedad", hum);
    jsonRaiz.set("alarma_activa", alarma);
    jsonRaiz.set("origen_alarma", origenAlarmaActual);
    jsonRaiz.set("descripcion_monitoreo", descripcionCompletaActual);
    jsonRaiz.set("fecha", fechaActualStr);
    jsonRaiz.set("hora", horaActualStr);
    jsonRaiz.set("via", "WIFI_DIRECTO");
    jsonRaiz.set("last_update_server", (int)epochActual);

    if (Firebase.RTDB.updateNode(&fbdo, DISPOSITIVO_PATH, &jsonRaiz)) {
      subidoDirecto = true;
      estadoEnlace = "Firebase Directo";

      // B. Si se cumplen los 30 segundos (o si acaba de saltar una alarma), guardar en /historial
      if (tocaHistorial30s || esNuevoDisparo) {
        FirebaseJson jsonHist;
        jsonHist.set("CO", co);
        jsonHist.set("PM2_5", (int)pm25);
        jsonHist.set("temperatura", temp);
        jsonHist.set("humedad", hum);
        jsonHist.set("alarma_activa", alarma);
        jsonHist.set("origen_alarma", origenAlarmaActual);
        jsonHist.set("descripcion", descripcionCompletaActual);
        jsonHist.set("fecha", fechaActualStr);
        jsonHist.set("hora", horaActualStr);
        jsonHist.set("timestamp_server", (int)epochActual);

        // Clave determinista basada en msgId para evitar duplicados con el Gateway
        String pathHist = String(DISPOSITIVO_PATH) + "/historial/msg_" + String(contadorMensajes);
        Firebase.RTDB.setJSON(&fbdo, pathHist, &jsonHist);
        Serial.printf("📦 [HISTORIAL 30s] Guardado en %s\n", pathHist.c_str());
      }

      // C. Nodo separado exclusivo de alarmas (/registro_alarmas) para descargas/auditoría
      if (esNuevoDisparo) {
        FirebaseJson jsonRegAlarma;
        jsonRegAlarma.set("fecha", fechaActualStr);
        jsonRegAlarma.set("hora", horaActualStr);
        jsonRegAlarma.set("origen", origenAlarmaActual);
        jsonRegAlarma.set("descripcion", descripcionCompletaActual);
        jsonRegAlarma.set("CO", co);
        jsonRegAlarma.set("PM2_5", (int)pm25);
        jsonRegAlarma.set("temperatura", temp);
        jsonRegAlarma.set("humedad", hum);
        jsonRegAlarma.set("via", "WIFI_DIRECTO");
        jsonRegAlarma.set("timestamp_server", (int)epochActual);

        String pathAlarma = String(DISPOSITIVO_PATH) + "/registro_alarmas/alm_" + String(contadorMensajes);
        Firebase.RTDB.setJSON(&fbdo, pathAlarma, &jsonRegAlarma);
        Serial.printf("🚨 [AUDITORÍA ALARMA] Guardada en %s\n", pathAlarma.c_str());
      }
    }
  }

  // 2. FALLBACK A ESP-NOW (Solo si no se pudo subir por Wi-Fi directo)
  if (!subidoDirecto) {
    estadoEnlace = "ESP-NOW Gateway";
    strncpy(paquete.nodeId, NODE_ID, sizeof(paquete.nodeId));
    paquete.msgId = contadorMensajes;
    paquete.co = co;
    paquete.pm25 = (int)pm25;
    paquete.humedad = hum;
    paquete.temperatura = temp;
    paquete.alarmaActiva = alarma;
    paquete.esEventoNuevo = esNuevoDisparo;
    paquete.guardarHistorial30s = tocaHistorial30s;
    strncpy(paquete.fecha, fechaActualStr.c_str(), sizeof(paquete.fecha));
    strncpy(paquete.hora, horaActualStr.c_str(), sizeof(paquete.hora));
    strncpy(paquete.origen, origenAlarmaActual.c_str(), sizeof(paquete.origen));
    strncpy(paquete.descripcion, descripcionCompletaActual.c_str(), sizeof(paquete.descripcion));

    esp_now_send(broadcastAddress, (uint8_t *)&paquete, sizeof(paquete));
    Serial.printf("📡 [FALLBACK ESP-NOW] Paquete #%u enviado al Gateway\n", contadorMensajes);
  }
}

