  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Monitoreo y Auditoría de Alarmas</title>
  <style>
    body { font-family: -apple-system, sans-serif; background: #0B0E14; color: #fff; margin: 0; padding: 15px; }
    .container { max-width: 480px; margin: 0 auto; }
    h2 { text-align: center; color: #00E676; margin: 5px 0 10px 0; }
    .banner { padding: 14px; border-radius: 10px; text-align: center; font-weight: bold; margin-bottom: 12px; }
    .desarmado { background: #161B26; color: #8F9CAE; border: 1px solid #2B3547; }
    .armado { background: #004D25; color: #00E676; border: 1px solid #00E676; }
    .peligro { background: #5A0A17; color: #FF1744; border: 1px solid #FF1744; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }
    .card { background: #161B26; padding: 12px; border-radius: 10px; border: 1px solid #2B3547; }
    .card h4 { margin: 0 0 5px 0; color: #8F9CAE; font-size: 0.78em; text-transform: uppercase; }
    .card .val { font-size: 1.4em; font-weight: bold; }
    .full { grid-column: span 2; }
    .desc-box { background: #161B26; padding: 12px; border-radius: 10px; border: 1px solid #2B3547; margin-bottom: 12px; font-size: 0.88em; line-height: 1.4; color: #ced4da; }
    input[type="text"] { width: 100%; box-sizing: border-box; padding: 12px; border-radius: 8px; border: 1px solid #2B3547; background: #0B0E14; color: #fff; margin-bottom: 10px; }
    button, .btn-link { display: block; width: 100%; box-sizing: border-box; text-align: center; text-decoration: none; padding: 13px; border: none; border-radius: 8px; font-size: 0.95em; font-weight: bold; cursor: pointer; margin-bottom: 8px; }
    .btn-armar { background: #00E676; color: #0B0E14; }
    .btn-desarmar { background: #2B3547; color: #fff; }
    .btn-panico { background: #FF1744; color: #fff; }
    .btn-silenciar { background: #FF9100; color: #fff; }
    .btn-descargar { background: #007AFF; color: #fff; }
  </style>
</head>
<body>
  <div class="container">
    <h2>AUDITORÍA NODO MINERO</h2>
    <div id="banner" class="banner desarmado">CONECTANDO...</div>
    <div class="grid">
      <div class="card"><h4>PM2.5</h4><div class="val" id="pm">--</div></div>
      <div class="card"><h4>Gas CO</h4><div class="val" id="co">--</div></div>
      <div class="card"><h4>Clima</h4><div class="val"><span id="temp">--</span>°C | <span id="hum">--</span>%</div></div>
      <div class="card"><h4>Fecha / Hora</h4><div class="val" style="font-size:1em;" id="reloj">--</div></div>
    </div>

    <div class="desc-box">
      <strong>Detalle en Vivo (<span id="origen">--</span>):</strong><br>
      <span id="descripcion">Cargando descripción...</span>
    </div>

    <input type="text" id="motivoInput" placeholder="Describe el motivo si activas alarma manual...">
    <button class="btn-panico" onclick="activarManualConMotivo()">! ACTIVAR ALARMA MANUAL CON DETALLE !</button>
    <button id="btn-toggle" class="btn-armar" onclick="cambiar()">ARMAR SISTEMA</button>
    <button class="btn-silenciar" onclick="act('/silenciar')">SILENCIAR ALARMA</button>
    <a class="btn-link btn-descargar" href="/descargar_alarmas" download="historial_alarmas.csv">DESCARGAR HISTORIAL DE ALARMAS (CSV)</a>
  </div>
  <script>
    let arm = false;
    function actualizar() {
      fetch('/api/datos').then(r => r.json()).then(d => {
        document.getElementById('pm').innerText = d.pm25.toFixed(1) + " ug/m3";
        document.getElementById('co').innerText = d.co + " ADC";
        document.getElementById('temp').innerText = d.t.toFixed(1);
        document.getElementById('hum').innerText = d.h;
        document.getElementById('reloj').innerText = d.fecha + " " + d.hora;
        document.getElementById('origen').innerText = d.origen;
        document.getElementById('descripcion').innerText = d.descripcion;
        arm = d.armado;
        const b = document.getElementById('banner');
        const btn = document.getElementById('btn-toggle');
        if (d.sirena) { b.className = "banner peligro"; b.innerText = "! ALARMA ACTIVA (" + d.origen + ") !"; }
        else if (d.armado) { b.className = "banner armado"; b.innerText = "ENTORNO SEGURO (ARMADO)"; btn.className = "btn-desarmar"; btn.innerText = "DESARMAR SISTEMA"; }
        else { b.className = "banner desarmado"; b.innerText = "SISTEMA DESARMADO"; btn.className = "btn-armar"; btn.innerText = "ARMAR SISTEMA"; }
      }).catch(e => console.log(e));
    }
    function cambiar() { act(arm ? '/desarmar' : '/armar'); }
    function act(u) { fetch(u).then(() => setTimeout(actualizar, 150)); }
    function activarManualConMotivo() {
      const txt = document.getElementById('motivoInput').value || 'Activada manualmente desde App Web';
      fetch('/panico?motivo=' + encodeURIComponent(txt)).then(() => setTimeout(actualizar, 150));
    }
    setInterval(actualizar, 1500);
    actualizar();
  </script>
</body>
</html>
)rawliteral";

void tareaServidorWeb(void *pvParameters) {
  IPAddress apIP(192, 168, 4, 1);
  WiFi.softAPConfig(apIP, apIP, IPAddress(255, 255, 255, 0));
  WiFi.softAP("NODO_MINERO_01", "12345678");
  dnsServer.start(53, "*", apIP);

  server.on("/", HTTP_GET, []() { server.send_P(200, "text/html", PAGINA_HTML); });
  server.on("/api/datos", HTTP_GET, []() {
    String json = "{";
    json += "\"co\":" + String(ultimoMQ2Medido) + ",";
    json += "\"pm25\":" + String(ultimoPM25Medido, 1) + ",";
    json += "\"t\":" + String(ultimaTemp, 1) + ",";
    json += "\"h\":" + String(ultimaHum) + ",";
    json += "\"armado\":" + String(sistemaArmado ? "true" : "false") + ",";
    json += "\"sirena\":" + String(estadoSirenaActiva ? "true" : "false") + ",";
    json += "\"fecha\":\"" + fechaActualStr + "\",";
    json += "\"hora\":\"" + horaActualStr + "\",";
    json += "\"origen\":\"" + origenAlarmaActual + "\",";
    json += "\"descripcion\":\"" + descripcionCompletaActual + "\"";
    json += "}";
    server.send(200, "application/json", json);
  });

  server.on("/armar", HTTP_GET, []() { sistemaArmado = true; panicoManual = false; server.send(200, "text/plain", "OK"); });
  server.on("/desarmar", HTTP_GET, []() { sistemaArmado = false; panicoManual = false; estadoSirenaActiva = false; digitalWrite(BALIZA_PIN, LOW); server.send(200, "text/plain", "OK"); });
  server.on("/panico", HTTP_GET, []() {
    if (server.hasArg("motivo") && server.arg("motivo").length() > 0) {
      motivoUsuarioManual = server.arg("motivo");
    } else {
      motivoUsuarioManual = "Activacion manual por operador";
    }
    panicoManual = true;
    estadoSirenaActiva = true;
    server.send(200, "text/plain", "OK");
  });
  server.on("/silenciar", HTTP_GET, []() { panicoManual = false; estadoSirenaActiva = false; digitalWrite(BALIZA_PIN, LOW); server.send(200, "text/plain", "OK"); });

  // Endpoint para descargar directamente las alarmas en formato CSV
  server.on("/descargar_alarmas", HTTP_GET, []() {
    server.sendHeader("Content-Disposition", "attachment; filename=historial_alarmas.csv");
    server.send(200, "text/csv", logAlarmasCSV);
  });

  server.onNotFound([]() {
    server.sendHeader("Location", "http://192.168.4.1/", true);
    server.send(302, "text/plain", "");
  });

  server.begin();
  for (;;) {
    dnsServer.processNextRequest();
    server.handleClient();
    vTaskDelay(pdMS_TO_TICKS(2));
  }
}

// =======================================
// SETUP
// =======================================
void setup() {
  Serial.begin(115200);
  delay(500);

  pinMode(BALIZA_PIN, OUTPUT);
  digitalWrite(BALIZA_PIN, LOW);
  pinMode(BOTON_MANUAL, INPUT_PULLUP);
  pinMode(BOTON_VENTANAS, INPUT_PULLUP);

  analogSetAttenuation(ADC_11db);
  pinMode(MQ2_PIN, INPUT);
  pinMode(PM25_VO_PIN, INPUT);
  pinMode(PM25_LED_PIN, OUTPUT);
  digitalWrite(PM25_LED_PIN, HIGH);

  tft.init();
  tft.setRotation(1);
  tft.fillScreen(COLOR_BG);

  iniciarI2S();
  dht.setup(DHT_PIN, DHTesp::DHT11);

  // Modo dual AP + STA para permitir portal local, Wi-Fi Firebase y ESP-NOW
  WiFi.mode(WIFI_AP_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  unsigned long t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < 4000) {
    delay(200);
  }

  // Sincronizar Fecha y Hora por NTP si hay internet
  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);

  if (esp_now_init() == ESP_OK) {
    esp_now_peer_info_t peerInfo = {};
    memcpy(peerInfo.peer_addr, broadcastAddress, 6);
    peerInfo.channel = 0;
    peerInfo.encrypt = false;
    esp_now_add_peer(&peerInfo);
  }

  fbConfig.database_url = FIREBASE_HOST;
  fbConfig.signer.test_mode = true;
  Firebase.begin(&fbConfig, &auth);
  Firebase.reconnectWiFi(true);

  xTaskCreatePinnedToCore(tareaServidorWeb, "WebTask", 8192, NULL, 1, NULL, 0);
}

// =======================================
// LOOP PRINCIPAL
// =======================================
void loop() {
  // 1. Botón físico BOOT: Si está sonando la silencia; si está en reposo cambia Armado/Desarmado
  if (digitalRead(BOTON_MANUAL) == LOW) {
    delay(50);
    if (digitalRead(BOTON_MANUAL) == LOW) {
      if (estadoSirenaActiva) {
        panicoManual = false;
        estadoSirenaActiva = false;
        digitalWrite(BALIZA_PIN, LOW);
      } else {
        sistemaArmado = !sistemaArmado;
      }
      while (digitalRead(BOTON_MANUAL) == LOW) delay(10);
    }
  }

  // 2. Botón GPIO 4: Cambiar ventana de la pantalla ST7789
  if (digitalRead(BOTON_VENTANAS) == LOW) {
    delay(50);
    if (digitalRead(BOTON_VENTANAS) == LOW) {
      ventanaActual = (ventanaActual + 1) % 3;
      renderizarVentana(ventanaActual, ultimoMQ2Medido, ultimoPM25Medido, ultimaTemp, ultimaHum, estadoSirenaActiva);
      while (digitalRead(BOTON_VENTANAS) == LOW) delay(10);
    }
  }

  // 3. Evaluación de Sensores cada 2 segundos y Guardado de Historial cada 30 segundos
  if (millis() - ultimoRefresco >= 2000) {
    ultimoRefresco = millis();

    ultimoMQ2Medido = analogRead(MQ2_PIN);
    ultimoPM25Medido = calcularDensidadPM25();

    TempAndHumidity lectura = dht.getTempAndHumidity();
    ultimaHum = (dht.getStatus() == DHTesp::ERROR_NONE) ? (int)lectura.humidity : 0;
    ultimaTemp = (dht.getStatus() == DHTesp::ERROR_NONE) ? lectura.temperature : 0.0;

    bool gasCritico = (ultimoMQ2Medido >= UMBRAL_MQ2_CRITICO);
    bool pmCritico  = (ultimoPM25Medido >= UMBRAL_PM25_CRITICO);

    if (panicoManual) {
      estadoSirenaActiva = true;
      origenAlarmaActual = "ACTIVACION_MANUAL_USUARIO";
    } else if (sistemaArmado && (gasCritico || pmCritico)) {
      estadoSirenaActiva = true;
      origenAlarmaActual = "CAUSA_NATURAL_SENSORES";
    } else if (!panicoManual && (!sistemaArmado || (!gasCritico && !pmCritico))) {
      estadoSirenaActiva = false;
      origenAlarmaActual = "NINGUNO";
    }

    // Detectar si la alarma acaba de activarse en este instante
    bool flancoSubidaAlarma = (estadoSirenaActiva && !estadoSirenaPrevio);
    estadoSirenaPrevio = estadoSirenaActiva;

    if (flancoSubidaAlarma) {
      ventanaActual = 0; // Mostrar pantalla principal de emergencia
    }

    digitalWrite(BALIZA_PIN, estadoSirenaActiva ? HIGH : LOW);

    // Evaluar si ya se cumplieron los 30 segundos para el historial
    bool guardarHistorial30s = false;
    if (millis() - ultimoHistorial30s >= INTERVALO_HISTORIAL_MS) {
      ultimoHistorial30s = millis();
      guardarHistorial30s = true;
    }

    // Subir estado, historial de 30s y registro detallado de alarma
    registrarYTransmitir(ultimoMQ2Medido, ultimoPM25Medido, ultimaTemp, ultimaHum, estadoSirenaActiva, flancoSubidaAlarma, guardarHistorial30s);

    // Actualizar interfaz gráfica
    renderizarVentana(ventanaActual, ultimoMQ2Medido, ultimoPM25Medido, ultimaTemp, ultimaHum, estadoSirenaActiva);
  }

  if (estadoSirenaActiva) {
    ejecutarPatronSirena();
  }

  delay(10);
}