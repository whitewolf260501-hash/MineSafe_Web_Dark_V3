// =======================================
// OBTENER FECHA Y HORA FORMATEADA
// =======================================
void actualizarFechaHora(unsigned long &epochOut) {
  struct tm timeinfo;
  if (getLocalTime(&timeinfo, 50)) {
    char bufFecha[16];
    char bufHora[16];
    strftime(bufFecha, sizeof(bufFecha), "%d/%m/%Y", &timeinfo);
    strftime(bufHora, sizeof(bufHora), "%H:%M:%S", &timeinfo);
    fechaActualStr = String(bufFecha);
    horaActualStr  = String(bufHora);
    time_t now;
    time(&now);
    epochOut = (unsigned long)now;
  } else {
    // Fallback con tiempo de actividad si no hay internet aún
    unsigned long segs = millis() / 1000;
    char bufHora[16];
    sprintf(bufHora, "%02lu:%02lu:%02lu", (segs / 3600) % 24, (segs / 60) % 60, segs % 60);
    horaActualStr = String(bufHora);
    epochOut = millis();
  }
}

// =======================================
// GENERADOR DE DESCRIPCIÓN DETALLADA
// =======================================
String construirDescripcionDetallada(bool alarma, bool manual, int co, float pm25, float t, int h) {
  char buffer[240];
  if (!alarma) {
    snprintf(buffer, sizeof(buffer),
      "Monitoreo normal en rango seguro. Lecturas: Gas CO=%d ADC, Polvo PM2.5=%.1f ug/m3, Temp=%.1f C, Humedad=%d%%.",
      co, pm25, t, h);
  } else if (manual) {
    snprintf(buffer, sizeof(buffer),
      "Alarma activada MANUALMENTE. Detalle del usuario: %s. Estado sensores al activarse: Gas CO=%d ADC, PM2.5=%.1f ug/m3, Temp=%.1f C, Hum=%d%%.",
      motivoUsuarioManual.c_str(), co, pm25, t, h);
  } else {
    String causaNatural = "";
    if (co >= UMBRAL_MQ2_CRITICO && pm25 >= UMBRAL_PM25_CRITICO) {
      causaNatural = "Concentracion critica simultanea de Gas CO y Polvo PM2.5";
    } else if (co >= UMBRAL_MQ2_CRITICO) {
      causaNatural = "Nivel critico de Gas inflamable/CO detectado por sensor MQ-2";
    } else if (pm25 >= UMBRAL_PM25_CRITICO) {
      causaNatural = "Densidad critica de polvo/humo detectada por sensor Sharp PM2.5";
    }
    snprintf(buffer, sizeof(buffer),
      "Alarma activa por CAUSA NATURAL (%s). Valores registrados: CO=%d ADC (Umbral %d), PM2.5=%.1f ug/m3 (Umbral %.0f), Temp=%.1f C, Hum=%d%%.",
      causaNatural.c_str(), co, UMBRAL_MQ2_CRITICO, pm25, UMBRAL_PM25_CRITICO, t, h);
  }
  return String(buffer);
}

// =======================================
// MUESTREO SHARP GP2Y10
// =======================================
float leerVoltajePM25() {
  digitalWrite(PM25_LED_PIN, LOW);
  delayMicroseconds(280);
  int rawADC = analogRead(PM25_VO_PIN);
  delayMicroseconds(40);
  digitalWrite(PM25_LED_PIN, HIGH);
  delayMicroseconds(9680);
  return (rawADC / 4095.0) * 3.3;
}

float calcularDensidadPM25() {
  float suma = 0.0;
  for (int i = 0; i < 5; i++) {
    suma += leerVoltajePM25();
    delay(2);
  }
  float vProm = suma / 5.0;
  return (vProm > PM25_VOLTAJE_BASE) ? (vProm - PM25_VOLTAJE_BASE) * 588.2 : 0.0;
}

// =======================================
// AUDIO DIGITAL I2S
// =======================================
void iniciarI2S() {
  i2s_config_t i2s_config = {
    .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_TX),
    .sample_rate = SAMPLE_RATE,
    .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
    .channel_format = I2S_CHANNEL_FMT_RIGHT_LEFT,
    .communication_format = I2S_COMM_FORMAT_STAND_I2S,
    .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
    .dma_buf_count = 6,
    .dma_buf_len = 64,
    .use_apll = false,
    .tx_desc_auto_clear = true
  };

  i2s_pin_config_t pin_config = {
    .bck_io_num = I2S_BCLK,
    .ws_io_num = I2S_LRC,
    .data_out_num = I2S_DIN,
    .data_in_num = I2S_PIN_NO_CHANGE
  };

  i2s_driver_install(I2S_NUM_0, &i2s_config, 0, NULL);
  i2s_set_pin(I2S_NUM_0, &pin_config);
}

void sonarSirena(int frecuencia, int duracionMs) {
  int numMuestras = (SAMPLE_RATE * duracionMs) / 1000;
  int16_t buffer[64];
  size_t bytesEscritos;
  float paso = (2.0 * PI * frecuencia) / SAMPLE_RATE;
  float fase = 0;
  int muestrasRestantes = numMuestras;

  while (muestrasRestantes > 0) {
    int lote = (muestrasRestantes > 32) ? 32 : muestrasRestantes;
    for (int i = 0; i < lote; i++) {
      int16_t m = (int16_t)(sin(fase) * 32767.0);
      buffer[i * 2] = m;
      buffer[i * 2 + 1] = m;
      fase += paso;
      if (fase >= 2.0 * PI) fase -= 2.0 * PI;
    }
    i2s_write(I2S_NUM_0, buffer, lote * 4, &bytesEscritos, portMAX_DELAY);
    muestrasRestantes -= lote;
  }
}

void ejecutarPatronSirena() {
  for (int f = 900; f <= 1900; f += 150) sonarSirena(f, 6);
  for (int f = 1900; f >= 900; f -= 150) sonarSirena(f, 6);
}

