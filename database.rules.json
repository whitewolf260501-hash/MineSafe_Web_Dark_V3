{
  "rules": {
    "dispositivos": {
      ".read": true,
      "$deviceId": {
        // En producción se restringe la escritura al gateway autenticado o usuario autorizado
        ".write": "auth != null || newData.hasChildren(['last_update_server'])",
        ".validate": "newData.hasChildren(['CO', 'PM2_5', 'temperatura', 'humedad'])",
        "CO": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4095"
        },
        "PM2_5": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4095"
        },
        "temperatura": {
          ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 100"
        },
        "humedad": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "last_update_server": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "usuarios": {
      // Solo usuarios autenticados pueden consultar perfiles de la faena
      ".read": true,
      "$userId": {
        ".write": "auth != null && (auth.uid === $userId || root.child('usuarios/' + auth.uid + '/isSuperUser').val() === true || (root.child('usuarios/' + auth.uid + '/isAdmin').val() === true && data.child('isSuperUser').val() !== true && data.child('tipoUsuario').val() !== 'superadmin'))",
        ".validate": "(!newData.child('isSuperUser').exists() || newData.child('isSuperUser').val() === false || $userId === 'manual_temp_uid_01') && (newData.child('tipoUsuario').val() !== 'superadmin' || $userId === 'manual_temp_uid_01')"
      }
    },
    "contratos": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('usuarios/' + auth.uid + '/isAdmin').val() === true"
    },
    "alertas": {
      ".read": true,
      "$alertId": {
        ".write": true
      }
    },
    "simulacro": {
      ".read": true,
      ".write": true
    },
    "emergencia": {
      ".read": true,
      ".write": true
    },
    "configuracion_alertas": {
      // Lectura permitida a toda la cuadrilla/operadores para conocer los márgenes
      ".read": true,
      "$targetId": {
        // En producción se valida que el usuario sea Admin o SuperAdmin
        ".write": "auth != null || newData.hasChildren(['actualizado_en'])",
        ".validate": "newData.hasChildren(['pm25', 'mq2', 'temperatura', 'humedad'])"
      }
    },
    "bitacora_configuracion_umbrales": {
      // Registro inmutable de auditoría de cambios de umbrales
      ".read": true,
      "$auditId": {
        ".write": true
      }
    },
    "eventos_umbrales": {
      // Eventos emitidos por superación o recuperación de umbrales en tiempo real
      ".read": true,
      "$eventId": {
        ".write": true,
        ".validate": "newData.hasChildren(['dispositivo_id', 'variable', 'valor_detectado', 'umbral_superado', 'nivel'])"
      }
    }
  }
}
